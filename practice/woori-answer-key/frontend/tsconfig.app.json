// src/ = 브라우저에서 도는 앱 코드 (하나 답지 frontend 와 같은 설정).
// Node 타입을 넣지 않는다: process.env, Buffer 를 쓰면 여기서 타입 오류가 난다
// (dev 서버에선 ReferenceError, 빌드에선 process.env 가 {} 로 바뀌어 조용히 undefined).
// 환경 값은 import.meta.env.VITE_* 로 읽는다.
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "allowArbitraryExtensions": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
